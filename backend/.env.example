# ScholarshipHunter Backend Environment Variables (Render / Production)
# Configure these in Render Dashboard -> Environment Variables

# ── AI Services ───────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── Security & Authentication ─────────────────────────────────────────────────
SECRET_KEY=generate_a_secure_random_32_byte_string_for_production_jwt

# ── CORS Configuration (Allow your Vercel frontend) ───────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=https://your-scholarship-hunter.vercel.app,https://yourdomain.com

# ── Database (Optional - Defaults to SQLite if omitted) ────────────────────────
# Example for Render Managed PostgreSQL / Supabase / Neon:
DATABASE_URL=postgresql://username:password@hostname:5432/scholarship_hunter

# ── Server Binding ────────────────────────────────────────────────────────────
# Render automatically injects PORT (default 10000)
PORT=10000
HOST=0.0.0.0
RELOAD=false
